---
/**
 * A project in a list. `feature` is a full-width spread (image beside the text);
 * `card` is the grid variant. Images sit in a uniform 4:3 frame: photographs
 * fill it, images with a transparent backdrop are fitted inside it uncropped.
 */
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { hasAlpha, photoFormats } from '../lib/images';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  variant?: 'feature' | 'card';
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { project, index, variant = 'card', headingLevel: H = 'h4' } = Astro.props;
const { title, summary, type, cover, draft, highlight } = project.data;
const href = url(`/work/${project.id}/`);
const n = String(index + 1).padStart(2, '0');
const fitted = await hasAlpha(cover);
const formats = await photoFormats(cover);
---

<article class:list={['project-card', `project-card--${variant}`]} data-reveal>
  <a class:list={['project-card__media', { 'is-fitted': fitted }]} href={href} tabindex="-1" aria-hidden="true">
    <Picture
      src={cover}
      alt=""
      width={cover.width}
      quality={82}
      sizes={variant === 'feature'
        ? '(min-width: 1440px) 820px, (min-width: 901px) 58vw, 100vw'
        : '(min-width: 1440px) 640px, (min-width: 721px) 46vw, 100vw'}
      {...formats}
    />
  </a>
  <div class="project-card__meta">
    <p class="project-card__no label">
      <span class="project-card__n">{n}</span>
      <span>{type}</span>
      {draft && <span data-pending title="Draft — visible in review builds only">Draft</span>}
    </p>
    {highlight && <p class="project-card__highlight label label--accent eyebrow">{highlight}</p>}
    <H class:list={['project-card__title', variant === 'feature' ? 'h1' : 'h2']}>
      <a href={href}>{title}</a>
    </H>
    <p class="project-card__summary muted">{summary}</p>
    <a class="link-arrow" href={href} aria-label={`View project: ${title}`}>
      View project <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .project-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-deep);
  }

  /* Let <picture> pass through so the image can fill the frame. */
  .project-card__media :global(picture) {
    display: contents;
  }

  .project-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease);
  }

  .project-card__media.is-fitted :global(img) {
    object-fit: contain;
    padding: var(--s-4);
  }

  .project-card:hover .project-card__media :global(img) {
    transform: scale(1.025);
  }

  .project-card__meta {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--s-3);
  }

  .project-card__no {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    width: 100%;
    padding-top: var(--s-2);
    border-top: 1px solid var(--rule-strong);
  }

  .project-card__n {
    color: var(--accent-text);
  }

  .project-card__title a {
    text-decoration: none;
  }

  .project-card__title a:hover {
    color: var(--accent-text);
  }

  .project-card__summary {
    max-width: 52ch;
    text-wrap: pretty;
  }

  /* Feature: a spread, the image over seven columns and the text beside it. */
  .project-card--feature {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: end;
  }

  .project-card--feature .project-card__media {
    grid-column: 1 / span 7;
    aspect-ratio: 4 / 3;
  }

  .project-card--feature .project-card__meta {
    grid-column: 8 / -1;
    gap: var(--s-4);
  }

  .project-card--feature .project-card__title {
    font-size: clamp(2.75rem, 5vw, 4.75rem);
  }

  .project-card--feature .project-card__summary {
    font-size: var(--text-lead);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .project-card--feature .project-card__media,
    .project-card--feature .project-card__meta {
      grid-column: 1 / -1;
    }
  }
</style>
