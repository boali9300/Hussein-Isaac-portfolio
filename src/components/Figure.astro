---
/**
 * One architectural image, captioned like a plate in a monograph. Drawings have
 * transparent sheets and sit on the page paper, served lossless (WebP, PNG
 * fallback); renders and photos are AVIF (see lib/images.ts for fallbacks).
 * Images are never enlarged past their native size. Click to inspect in the
 * lightbox. Inside a project page, captions are numbered (Fig. 01, 02 …).
 */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import { photoFormats } from '../lib/images';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  kind?: 'drawing' | 'render';
  /** `sizes` attribute; defaults to the full content width. */
  sizes?: string;
  priority?: boolean;
  zoom?: boolean;
  /** full = content width; narrow = centered, for tall drawings. */
  width?: 'full' | 'narrow';
  class?: string;
}

const {
  src,
  alt,
  caption,
  credit,
  kind = 'drawing',
  sizes = `(min-width: 1440px) 1312px, calc(100vw - 2 * clamp(16px, 4.5vw, 64px))`,
  priority = false,
  zoom = true,
  width = 'full',
  class: className,
} = Astro.props;

const isDrawing = kind === 'drawing';
const picture = isDrawing
  ? { formats: ['webp'] as 'webp'[], fallbackFormat: 'png' as const }
  : { ...(await photoFormats(src)), quality: 82 };
const full = zoom
  ? await getImage({
      src,
      width: src.width,
      format: isDrawing ? 'webp' : 'avif',
      ...(isDrawing ? {} : { quality: 90 }),
    })
  : undefined;
---

<figure class:list={['figure', `figure--${kind}`, `figure--${width}`, className]} data-reveal>
  <div class="figure__frame">
    {
      zoom && full ? (
        <button
          class="figure__zoom"
          type="button"
          data-zoom-src={full.src}
          data-zoom-width={src.width}
          data-zoom-height={src.height}
          data-zoom-alt={alt}
          data-zoom-caption={caption}
          aria-label={`Enlarge image: ${alt}`}
        >
          <Picture src={src} alt={alt} width={src.width} sizes={sizes} priority={priority} {...picture} />
        </button>
      ) : (
        <Picture src={src} alt={alt} width={src.width} sizes={sizes} priority={priority} {...picture} />
      )
    }
  </div>
  {
    (caption || credit) && (
      <figcaption class="figure__caption">
        {caption && <span class="figure__title">{caption}</span>}
        {credit && <span class="figure__credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 0;
  }

  .figure--narrow {
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
  }

  .figure__frame {
    flex: 1;
    display: grid;
    place-items: center;
  }

  /* Drawings have transparent sheets and sit directly on the page paper. */
  .figure--drawing .figure__frame {
    padding-block: clamp(var(--s-3), 2vw, var(--s-5));
  }

  .figure__zoom {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    max-width: 100%;
  }

  .figure__zoom :global(img) {
    transition: opacity var(--dur-fast) var(--ease);
  }

  .figure__zoom:hover :global(img) {
    opacity: 0.92;
  }

  .figure__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    padding-top: var(--s-2);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--graphite);
  }

  /* Plate numbers, counted per project page (the counter is reset there). */
  :global(.case__body) .figure__title::before {
    counter-increment: figure;
    content: 'Fig. ' counter(figure, decimal-leading-zero) ' — ';
    color: var(--accent-text);
  }

  .figure__credit {
    font-style: normal;
  }
</style>
